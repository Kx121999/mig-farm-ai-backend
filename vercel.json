{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "knowledge_v27/*.json"
    },
    "api/health.js": {
      "includeFiles": "knowledge_v27/*.json"
    },
    "api/admin-dashboard.js": {
      "includeFiles": "**/*.json"
    }
  },
  "rewrites": [
    {"source": "/admin", "destination": "/admin/index.html"},
    {"source": "/admin/", "destination": "/admin/index.html"}
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "private, no-store, max-age=0"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
      ]
    }
  ]
}
