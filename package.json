export function cleanText(value,maxLength=2000){
  if(typeof value!=="string")return "";
  return value.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,"").trim().slice(0,maxLength);
}

export function safeLocale(value){
  return value==="en"?"en":"ar";
}

export function safePageUrl(value){
  if(!value||typeof value!=="string")return "";
  try{
    const url=new URL(value);
    if(!["http:","https:"].includes(url.protocol))return "";
    return url.toString().slice(0,1000);
  }catch{
    return "";
  }
}

export function detectIntent(message){
  const text=String(message||"").toLowerCase();

  if(/(موظف|بني ادم|إنسان|انسان|واتساب|whatsapp|human|agent|اتصل)/i.test(text))return "human_support";
  if(/(سعر|بكام|price|cost|درهم|aed|اسعار|الاسعار)/i.test(text))return "price";
  if(/(متوفر|مخزون|stock|available|availability|موجود)/i.test(text))return "availability";
  if(/(اشتري|شراء|اطلب|طلب|buy|order|purchase)/i.test(text))return "purchase";
  if(/(بذور|فلفل|خيار|باذنجان|طماطم|بطيخ|شمام|بامية|بصل|كوس|سماد|ري|مبيد|seeds|pepper|cucumber|eggplant|tomato|fertilizer|irrigation)/i.test(text))return "product_advice";

  return "general";
}

export function jsonResponse(data,status=200,headers={}){
  return new Response(JSON.stringify(data),{
    status,
    headers:{
      "Content-Type":"application/json; charset=utf-8",
      ...headers
    }
  });
}
