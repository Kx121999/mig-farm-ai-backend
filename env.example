# Core neural agent (optional; deterministic mode works without it)
# Add the real value in Vercel only. Never commit it to GitHub.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
NEURAL_AGENT_MODE=adaptive
NEURAL_TIMEOUT_MS=9000
NEURAL_MAX_ROUNDS=5

# V31 meaning-first interpreter (enabled automatically when OPENAI_API_KEY exists)
LLM_FIRST_V31_ENABLED=true
OPENAI_INTENT_MODEL=gpt-5.6
LLM_FIRST_TIMEOUT_MS=7000

# FINAL_PRODUCTION_OS adaptive critic (uses the same OpenAI key)
# It runs only when deterministic review finds a quality gap; hard safety remains deterministic.
FINAL_CRITIC_ENABLED=true
OPENAI_CRITIC_MODEL=gpt-5.6
FINAL_CRITIC_TIMEOUT_MS=5200

# V28 scalable knowledge plane (optional; 400 MB local fallback always remains available)
MIG_ENTERPRISE_RETRIEVAL_ENABLED=false
OPENAI_VECTOR_STORE_ID=
MIG_ENTERPRISE_RETRIEVAL_TIMEOUT_MS=6000

# Allowed website origins
ALLOWED_ORIGINS=https://www.migfarm.com,https://migfarm.com,https://edu-mig-for-agriculture.odoo.com

# Server-side session persistence (optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MIG_SESSION_TTL_SECONDS=604800

# V28 privacy-safe operational telemetry
MIG_V28_TELEMETRY_KEY=mig:v28:telemetry
MIG_V28_TELEMETRY_TTL_SECONDS=7776000
MIG_ADMIN_REDACTED_TRANSCRIPTS=false

# Secure Odoo actions — disabled until every value is configured
ODOO_ACTIONS_ENABLED=false
ODOO_ACTION_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_ACTION_TIMEOUT_MS=10000

# V28 protected dashboard — generate two different long random values in Vercel
MIG_ADMIN_TOKEN=
MIG_ADMIN_SESSION_SECRET=
MIG_ADMIN_SESSION_HOURS=8

# Legacy protected endpoints — can use different random values
MIG_METRICS_TOKEN=
MIG_LEARNING_TOKEN=
